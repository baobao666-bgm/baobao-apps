{
  "version": "0.11.18",
  "description": "Typora：极简、无干扰的 Markdown 编辑器（所见即所得），支持大纲、表格、数学公式、代码高亮与多主题；本包基于官方最后一个免费版本 0.11.18 打包，内置过期弹窗修复与更新提示屏蔽，安装即用。",
  "homepage": "https://typora.io/",
  "license": "Proprietary",
  "architecture": {
    "64bit": {
      "url": "https://raw.githubusercontent.com/baobao666-bgm/typora-0.11.18/master/typora-setup-x64-0.11.18.exe",
      "hash": "2c2c80c32d813744b6d48851687c752e819c0cd4246440842effd3d10473dd22"
    },
    "32bit": {
      "url": "https://raw.githubusercontent.com/baobao666-bgm/typora-0.11.18/master/typora-setup-ia32-0.11.18.exe",
      "hash": "e1e9aec7a251472c25afffcde292ea67fb913e8984c816b8e516244a3160effc"
    }
  },
  "innosetup": true,
  "bin": "Typora.exe",
  "shortcuts": [
    ["Typora.exe", "Typora"]
  ],
  "post_install": [
    "# A. defensive: stop any Typora launched from this app dir before touching data",
    "try {",
    "  Get-Process -Name 'Typora' -ErrorAction SilentlyContinue | Where-Object { ($_.Path -like ($dir + '*')) -or ($_.Path -like ($original_dir + '*')) } | Stop-Process -Force -ErrorAction SilentlyContinue",
    "} catch {}",
    "# B. redirect %APPDATA%\\Typora to <original_dir>\\TyporaData through a junction",
    "try {",
    "  $jlink = Join-Path $env:APPDATA 'Typora'",
    "  $jtarget = Join-Path $original_dir 'TyporaData'",
    "  if (-not (Test-Path -LiteralPath $jtarget)) { New-Item -ItemType Directory -Path $jtarget -Force -ErrorAction SilentlyContinue | Out-Null }",
    "  $it = $null",
    "  try { $it = Get-Item -Force -LiteralPath $jlink -ErrorAction Stop } catch { $it = $null }",
    "  if (-not $it) {",
    "    try { [System.IO.Directory]::Delete($jlink, $false) } catch {}",
    "    New-Item -Path $jlink -ItemType Junction -Value $jtarget -ErrorAction SilentlyContinue | Out-Null",
    "    if (-not (Test-Path -LiteralPath $jlink)) { throw 'junction creation failed' }",
    "  } else {",
    "    $isLink = ($it.LinkType -eq 'Junction') -or (($it.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -eq [System.IO.FileAttributes]::ReparsePoint)",
    "    if ($isLink) {",
    "      $match = $false",
    "      $want = $jtarget.TrimEnd('\\')",
    "      foreach ($t in @($it.Target)) { if ($t -and ($t.TrimEnd('\\') -ieq $want)) { $match = $true } }",
    "      if (-not $match) {",
    "        attrib -R /L $jlink 2>$null",
    "        try { [System.IO.Directory]::Delete($jlink, $false) } catch {}",
    "        if (Test-Path -LiteralPath $jlink) { cmd /c rd \"$jlink\" 2>$null }",
    "        if (-not (Test-Path -LiteralPath $jtarget)) { New-Item -ItemType Directory -Path $jtarget -Force -ErrorAction SilentlyContinue | Out-Null }",
    "        New-Item -Path $jlink -ItemType Junction -Value $jtarget -ErrorAction SilentlyContinue | Out-Null",
    "      }",
    "    } else {",
    "      $roco = Join-Path (Join-Path $env:SystemRoot 'System32') 'Robocopy.exe'",
    "      & $roco $jlink $jtarget /E /COPY:DAT /R:2 /W:2 | Out-Null",
    "      $rc = $LASTEXITCODE",
    "      if ($rc -lt 8) {",
    "        Remove-Item -LiteralPath $jlink -Recurse -Force -ErrorAction Stop",
    "        if (-not (Test-Path -LiteralPath $jtarget)) { New-Item -ItemType Directory -Path $jtarget -Force -ErrorAction SilentlyContinue | Out-Null }",
    "        New-Item -Path $jlink -ItemType Junction -Value $jtarget -ErrorAction SilentlyContinue | Out-Null",
    "        if (-not (Test-Path -LiteralPath $jlink)) { throw 'junction creation failed after migration' }",
    "      } else {",
    "        Write-Host \"Typora: data migration failed (robocopy exit $rc); keeping $jlink as a normal folder.\"",
    "      }",
    "    }",
    "  }",
    "} catch { Write-Host \"Typora: profile redirection skipped: $($_.Exception.Message)\" }",
    "# C. registry fix: pre-set IDate and deny false 'beta expired' popup",
    "try {",
    "  $rk = 'HKCU:\\SOFTWARE\\Typora'",
    "  if (-not (Test-Path $rk)) { New-Item -Path $rk -Force -ErrorAction SilentlyContinue | Out-Null }",
    "  Set-ItemProperty -Path $rk -Name 'IDate' -Value '12/31/2099' -Type String -Force -ErrorAction SilentlyContinue",
    "  $sub = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('SOFTWARE\\Typora', [Microsoft.Win32.RegistryKeyPermissionCheck]::ReadWriteSubTree, [System.Security.AccessControl.RegistryRights]::ChangePermissions -bor [System.Security.AccessControl.RegistryRights]::ReadPermissions)",
    "  if ($sub) {",
    "    $sd = $sub.GetAccessControl([System.Security.AccessControl.AccessControlSections]::Access)",
    "    foreach ($s in 'S-1-5-11','S-1-5-18','S-1-5-32-544','S-1-5-32-545') {",
    "      $sid = New-Object System.Security.Principal.SecurityIdentifier($s)",
    "      $rule = New-Object System.Security.AccessControl.RegistryAccessRule($sid, 'ReadKey, QueryValues, EnumerateSubKeys, Notify, SetValue, CreateSubKey, Delete, WriteKey', 'ContainerInherit', 'None', 'Deny')",
    "      $sd.AddAccessRule($rule)",
    "    }",
    "    $sub.SetAccessControl($sd)",
    "    $sub.Close()",
    "  }",
    "} catch {}",
    "# D. seed profile.data (disable auto-update / skip the current latest version); runs after junction, so it lands in TyporaData",
    "try {",
    "  $pd = Join-Path $env:APPDATA 'Typora\\profile.data'",
    "  $pdir = Split-Path $pd",
    "  if (-not (Test-Path $pdir)) { New-Item -ItemType Directory -Path $pdir -Force -ErrorAction SilentlyContinue | Out-Null }",
    "  $obj = $null",
    "  if (Test-Path $pd) {",
    "    try {",
    "      $hex = (Get-Content $pd -Raw -ErrorAction Stop).Trim()",
    "      if ($hex.Length % 2 -eq 0 -and $hex.Length -gt 0) {",
    "        $bytes = New-Object byte[] ($hex.Length / 2)",
    "        for ($i = 0; $i -lt $bytes.Length; $i++) { $bytes[$i] = [Convert]::ToByte($hex.Substring($i * 2, 2), 16) }",
    "        $obj = [System.Text.Encoding]::UTF8.GetString($bytes) | ConvertFrom-Json",
    "      }",
    "    } catch { $obj = $null }",
    "  }",
    "  if (-not $obj) { $obj = New-Object PSObject }",
    "  $skip = $null",
    "  foreach ($u in 'https://typora.io/releases/stable','https://typoraio.cn/releases/stable.html') {",
    "    if ($skip) { break }",
    "    try {",
    "      $tmp = Join-Path $env:TEMP 'typora_latest.html'",
    "      & (Join-Path $env:SystemRoot 'System32\\curl.exe') -sL --max-time 15 -o $tmp $u 2>$null",
    "      if (Test-Path $tmp) {",
    "        $page = [System.IO.File]::ReadAllText($tmp, [System.Text.Encoding]::UTF8)",
    "        Remove-Item $tmp -Force -ErrorAction SilentlyContinue",
    "        $m = [regex]::Match($page, '<h2>([0-9]+\\.[0-9]+\\.[0-9]+)</h2>')",
    "        if ($m.Success) { $skip = $m.Groups[1].Value }",
    "      }",
    "    } catch { $skip = $null }",
    "  }",
    "  if (-not $skip) { try { if ($obj.skipUpdate) { $skip = $obj.skipUpdate } } catch { $skip = $null } }",
    "  if (-not $skip) { $skip = '1.14.10' }",
    "  $obj | Add-Member -Force -MemberType NoteProperty -Name 'enableAutoUpdate' -Value $false",
    "  $obj | Add-Member -Force -MemberType NoteProperty -Name 'skipUpdate' -Value $skip",
    "  $json = $obj | ConvertTo-Json -Compress",
    "  $out = ([System.BitConverter]::ToString([System.Text.Encoding]::UTF8.GetBytes($json))).Replace('-', '').ToLower()",
    "  Set-Content -Path $pd -Value $out -NoNewline -Encoding Ascii -ErrorAction SilentlyContinue",
    "  Write-Host \"Typora: skipUpdate preset to $skip\"",
    "} catch {}"
  ],
  "pre_uninstall": [
    "# A. stop running Typora",
    "try {",
    "  Get-Process -Name 'Typora' -ErrorAction SilentlyContinue | Where-Object { $_.Path -like ($dir + '*') } | Stop-Process -Force -ErrorAction SilentlyContinue",
    "} catch {}",
    "# B. remove the %APPDATA%\\Typora junction only (never recurse through it)",
    "try {",
    "  $jlink = Join-Path $env:APPDATA 'Typora'",
    "  $it = $null",
    "  try { $it = Get-Item -Force -LiteralPath $jlink -ErrorAction Stop } catch { $it = $null }",
    "  if ($it -and (($it.LinkType -eq 'Junction') -or (($it.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -eq [System.IO.FileAttributes]::ReparsePoint))) {",
    "    attrib -R /L $jlink 2>$null",
    "    try { [System.IO.Directory]::Delete($jlink, $false) } catch {}",
    "    if (Test-Path -LiteralPath $jlink) { cmd /c rd \"$jlink\" 2>$null }",
    "  }",
    "} catch {}",
    "# C. restore registry permissions and remove the key",
    "try {",
    "  $sub = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('SOFTWARE\\Typora', [Microsoft.Win32.RegistryKeyPermissionCheck]::ReadWriteSubTree, [System.Security.AccessControl.RegistryRights]::ChangePermissions -bor [System.Security.AccessControl.RegistryRights]::ReadPermissions)",
    "  if ($sub) {",
    "    $sd = $sub.GetAccessControl([System.Security.AccessControl.AccessControlSections]::Access)",
    "    @($sd.GetAccessRules($true, $true, [System.Security.Principal.SecurityIdentifier])) | Where-Object { $_.AccessControlType -eq 'Deny' } | ForEach-Object { $sd.RemoveAccessRule($_) | Out-Null }",
    "    $sub.SetAccessControl($sd)",
    "    $sub.Close()",
    "  }",
    "  [Microsoft.Win32.Registry]::CurrentUser.DeleteSubKeyTree('SOFTWARE\\Typora', $false)",
    "} catch {}"
  ],
  "notes": "Typora 0.11.18（官方最后一个免费版本；本包提供 64 位与 32 位两种架构，默认安装 64 位，如需 32 位可用 scoop install --arch 32bit）。本包安装时已内置修复：① 对注册表 HKCU\\SOFTWARE\\Typora 预置 IDate 为远期时间并设置拒绝读写权限（保留权限管理能力），避免出现「This beta version of Typora is expired」过期弹窗；② 预置用户配置关闭「自动检查更新」，并跳过 Typora 当前最新版本（安装时自动查询官方发布页；查询失败时回退为已有记录或最近已知版本），启动时不再弹出更新提示窗口；③ 卸载时自动结束 Typora 进程、移除数据目录联接、还原注册表权限并清理相关注册表项，不会残留。数据位置：用户数据目录 %APPDATA%\\Typora 在安装时会重定向到安装目录下的 TyporaData（用户视角即 current\\TyporaData，实际位于版本目录 ...\\apps\\typora0.11.18\\0.11.18\\TyporaData），C 盘只保留一个目录联接，数据随 Scoop 一起存放、便于整体迁移。请注意本包采用便携语义：卸载会连同 TyporaData 一起删除，如需保留数据请在卸载前自行备份。启动方式：命令行输入 typora，或从开始菜单打开「Typora」。另请勿手动改动或删除上述注册表项与权限，否则过期弹窗可能复现；如需调整，卸载后重新安装本包即可。"
}
